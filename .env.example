# 复制为 .env 后按需修改（已存在的系统环境变量优先级更高）

# ---------- 基本 ----------
# 登录密码（明文，仅个人使用；也可以改用下面的 INKNOTE_PASSWORD_HASH）
INKNOTE_PASSWORD=inknote
# 更安全的方式：用 `python run.py --hash-password 你的密码` 生成哈希后填这里
# INKNOTE_PASSWORD_HASH=pbkdf2_sha256$200000$....

# 会话签名密钥。留空则在 data/.secret 里自动生成并复用
# INKNOTE_SECRET=

# ---------- 站点 ----------
INKNOTE_TITLE=墨痕
INKNOTE_SUBTITLE=一个人的笔记与写作
INKNOTE_AUTHOR=我
# 生成 RSS / sitemap 用的对外地址（部署时改成真实域名，末尾不要带 /）
INKNOTE_BASE_URL=http://127.0.0.1:8000
INKNOTE_DESCRIPTION=这里是我的个人笔记与博客。
# 每页条数
INKNOTE_PER_PAGE=12

# ---------- 存储 ----------
# 数据目录（SQLite 数据库与上传的图片都在这里）
# INKNOTE_DATA_DIR=./data
# 单个上传图片大小上限（字节）
INKNOTE_MAX_UPLOAD_BYTES=8388608

# ---------- 行为 ----------
# 会话有效期（天）
INKNOTE_SESSION_DAYS=30
# 监听地址与端口（run.py 读取，也可用 --host / --port 覆盖）
INKNOTE_HOST=127.0.0.1
INKNOTE_PORT=8000
# 开发用：开启调试信息（默认关闭）
INKNOTE_DEBUG=0
# 每篇笔记保留的历史版本数
INKNOTE_VERSION_KEEP=20
# 回收站保留天数，超期在启动时自动清理
INKNOTE_TRASH_DAYS=30
# 后台线程总开关（默认开）：每小时检查自动备份、每 30 分钟跟进向量索引。
# 部署时不用管；脚本里只想跑一次性任务时设 0 可以避免后台线程干扰。
# INKNOTE_WORKERS=1

# ---------- AI（可选，留空则不启用；入口仍然可见，点击会提示未配置） ----------
# 任何 OpenAI 兼容的 /chat/completions 服务都可以，例如 OpenAI、DeepSeek、通义、本地 Ollama/vLLM
# 也可以全部留空，登录后在网站的「设置」页里图形化配置（页面保存的优先生效）
# INKNOTE_AI_BASE_URL=https://api.deepseek.com/v1
# INKNOTE_AI_API_KEY=sk-xxxx
# INKNOTE_AI_MODEL=deepseek-chat
# 向量检索用的 embedding 模型（留空则「问笔记」走关键词检索）
# INKNOTE_AI_EMBED_MODEL=text-embedding-3-small
# INKNOTE_AI_TIMEOUT=45
